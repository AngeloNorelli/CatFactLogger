<Window x:Class="CatFactLogger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="350" Width="525">
    <Grid Margin="16">
      <Grid.RowDefinitions>
	    <RowDefinition Height="Auto"/>
	    <RowDefinition Height="*"/>
		<RowDefinition Height="Auto"/>
		<RowDefinition Height="Auto"/>
	  </Grid.RowDefinitions>
	
	  <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
		<Button Content="Fetch Cat Fact"
				Command="{Binding FetchFactCommand}"
				Padding="8,4"/>
		<TextBlock Text="{Binding StatusText}"
				   VerticalAlignment="Center"
				   Margin="8,0,0,0"/>
	  </StackPanel>
	  
	  <ListBox x:Name="HistoryListBox"
			   Grid.Row="1" 
			   ItemsSource="{Binding History}"
			   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
			   HorizontalAlignment="Stretch">
		<ListBox.ItemContainerStyle>
		  <Style TargetType="ListBoxItem">
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
		  </Style>
		</ListBox.ItemContainerStyle>
		<ListBox.ItemTemplate>
		  <DataTemplate>
			<TextBlock Text="{Binding}"
					   TextTrimming="CharacterEllipsis"
					   TextWrapping="NoWrap"
					   ToolTip="{Binding}"/>
		  </DataTemplate>
		</ListBox.ItemTemplate>
	  </ListBox>
	  
	  <TextBlock Grid.Row="2"
				 Text="{Binding SelectedItem, ElementName=HistoryListBox}"
				 TextWrapping="Wrap"
				 Margin="0,8,0,0"/>
	  
	  <TextBlock Grid.Row="3" Text="{Binding FilePath}"
				 Margin="0,8,0,0" FontStyle="Italic" Opacity="0.7"/>
  </Grid>
</Window>